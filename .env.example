# Entorno y Servidor
PORT=8000
HOST=0.0.0.0
NODE_ENV=development

# Base de Datos PostgreSQL con PostGIS
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gasconnect_ibarra?schema=public"

# Redis (Colas BullMQ y Cache)
REDIS_URL="redis://localhost:6379"

# Servidor Centrifugo (Tiempo Real)
CENTRIFUGO_API_URL="http://localhost:8001/api"
CENTRIFUGO_API_KEY="gasconnect_centrifugo_secret_api_key_2026"
CENTRIFUGO_HMAC_SECRET_KEY="gasconnect_centrifugo_secret_hmac_2026"

# Motor de Rutas OSRM (Ibarra / Ecuador)
OSRM_URL="http://localhost:5000"

# Evolution API (WhatsApp Gateway)
EVOLUTION_API_URL="http://localhost:8080"
EVOLUTION_API_KEY="gasconnect_evolution_token_2026"
EVOLUTION_INSTANCE_NAME="gasconnect-ibarra-pilot"
