{
  "name": "gasconnect-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Sistema Monorepositorio de Coordinación y Despacho Oportuno de GLP en Ibarra",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "turbo run build 2>/dev/null || pnpm -r run build",
    "test": "turbo run test 2>/dev/null || pnpm -r test",
    "lint": "turbo run lint 2>/dev/null || pnpm -r lint",
    "dev": "turbo run dev",
    "clean": "turbo clean && rm -rf node_modules apps/*/node_modules packages/*/node_modules apps/*/dist packages/*/dist dist .turbo apps/*/.turbo packages/*/.turbo",
    "dev:api": "pnpm --filter @gasconnect/api dev",
    "dev:cab": "pnpm --filter cab-pwa dev",
    "dev:ops": "pnpm --filter ops-portal dev",
    "test:api": "pnpm --filter @gasconnect/api test",
    "test:cab": "pnpm --filter cab-pwa test",
    "test:ops": "pnpm --filter ops-portal test",
    "start": "pnpm --filter @gasconnect/api start",
    "prisma:generate": "pnpm --filter @gasconnect/api prisma:generate",
    "prisma:migrate": "pnpm --filter @gasconnect/api prisma:migrate",
    "prisma:seed": "pnpm --filter @gasconnect/api prisma:seed",
    "whatsapp:setup": "pnpm --filter @gasconnect/api whatsapp:setup"
  },
  "keywords": [
    "gas",
    "dispatch",
    "ibarra",
    "fastify",
    "postgis",
    "centrifugo"
  ],
  "author": "GasConnect Team",
  "license": "MIT",
  "dependencies": {},
  "devDependencies": {
    "@gasconnect/tsconfig": "workspace:*",
    "@types/node": "^22.8.7",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "turbo": "^2.3.0",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "publicHoistPattern": [
      "*prisma*",
      "@prisma/*"
    ],
    "autoInstallPeers": true
  }
}
