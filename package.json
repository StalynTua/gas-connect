{
  "name": "gasconnect-ibarra",
  "version": "0.1.0",
  "description": "Sistema de Coordinación y Despacho Oportuno de GLP en Ibarra",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts",
    "whatsapp:setup": "tsx scripts/setup-evolution.ts",
    "dev:cab": "npm --prefix apps/cab-pwa run dev",
    "dev:ops": "npm --prefix apps/ops-portal run dev",
    "lint": "eslint src --ext .ts"
  },
  "keywords": [
    "gas",
    "dispatch",
    "ibarra",
    "fastify",
    "postgis",
    "centrifugo"
  ],
  "author": "GasConnect Team",
  "license": "MIT",
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@prisma/client": "^5.22.0",
    "bullmq": "^5.21.2",
    "centrifuge": "^5.2.2",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "ioredis": "^5.4.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.8.7",
    "pino-pretty": "^13.1.3",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
