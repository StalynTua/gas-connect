{
  "name": "@gasconnect/api",
  "version": "0.1.0",
  "private": true,
  "description": "API REST Fastify y Motor de Despacho DDD de GasConnect Ibarra",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "prisma generate && tsc",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts",
    "whatsapp:setup": "tsx scripts/setup-evolution.ts"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@gasconnect/contracts": "workspace:*",
    "@prisma/client": "^5.22.0",
    "bullmq": "^5.21.2",
    "centrifuge": "^5.2.2",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "ioredis": "^5.4.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@gasconnect/tsconfig": "workspace:*",
    "@types/node": "^22.8.7",
    "pino-pretty": "^13.1.3",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
